{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vinhthanh-3d",
  "main": "worker/worker.mjs",
  "compatibility_date": "2025-11-01",
  "build": { "command": "node tools/build.mjs" },
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "MemorialRoom" }]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vinhthanh-3d",
      // from `npx wrangler d1 create vinhthanh-3d` (an identifier, not a secret)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MemorialRoom"] }],
  "observability": { "enabled": true }
}
